FROM node:22-bookworm-slim AS portal
WORKDIR /src/apps/portal
COPY apps/portal/package*.json ./
RUN npm ci
COPY apps/portal/ ./
RUN npm run build

FROM python:3.12-slim-bookworm
WORKDIR /app
COPY pyproject.toml ./
COPY requirements.lock.txt ./
RUN pip install --no-cache-dir -r requirements.lock.txt
RUN python -m playwright install --with-deps --only-shell chromium
COPY services/ services/
COPY packages/ packages/
RUN pip install --no-cache-dir --no-deps '.[postgres]'
COPY tasks/ tasks/
COPY sources.lock.json ./
COPY --from=portal /src/apps/portal/dist apps/portal/dist
COPY apps/gomoku/simhei.ttf apps/gomoku/simhei.ttf
RUN useradd --create-home --uid 10001 vic && mkdir /data && chown vic:vic /data && mv /root/.cache/ms-playwright /opt/ms-playwright && chmod -R a+rX /opt/ms-playwright
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright VIC_DATA=/data VIC_ROOT=/app
USER vic
EXPOSE 8765
CMD ["uvicorn", "vic.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8765", "--workers", "1"]
